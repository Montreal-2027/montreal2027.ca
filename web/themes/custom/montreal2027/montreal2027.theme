<?php

/**
 * @file
 */

use Drupal\Core\Language\LanguageInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Component\Utility\Html;
use Drupal\Core\Url;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_entity_type_alter().
 *
 * Adds workspace handler to node entity type to fix workspace publishing errors.
 */
function montreal2027_entity_type_alter(array &$entity_types) {
  if (isset($entity_types['node'])) {
    $entity_types['node']->setHandlerClass('workspace', 'Drupal\workspaces\EntityTypeInfo\WorkspaceHandler');
  }
}

/**
 * Implements hook_form_alter().
 */
function montreal2027_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'user_logout_confirm') {
    $form['actions']['submit']['#theme_wrappers'] = ['input__submit__logout_confirm'];
  }

  if ($form_id === 'search_block_form') {
    $form['keys']['#attributes']['placeholder'] = \Drupal::translation()->translate('I am looking for');
  }

  if ($form_id === 'views_exposed_form') {
    $view = $form_state->getStorage()['view'];

    if ($view->id() === 'search_page' && $view->current_display === 'page_1') {
      // Modify the submit button.
      $form['actions']['submit']['#type'] = 'button';
      // Optional text, can be empty.
      $form['actions']['submit']['#value'] = '';
      // Add the Font Awesome icon markup via #prefix.
      // Replace fa-search with your desired icon.
      $form['actions']['submit']['#prefix'] = '<button type="submit" value="Search"><i class="fa-solid fa-magiifying-glass"></i>';
      $form['actions']['submit']['#suffix'] = '</button>';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for links__toolbar_user.
 */
function montreal2027_preprocess_links__toolbar_user(array &$variables): void {
  $logout_url = $variables['links']['logout']['link']['#url'] ?? NULL;
  if ($logout_url instanceof Url && $logout_url->getRouteName() === 'user.logout') {
    $variables['links']['logout']['link']['#url'] = Url::fromRoute('user.logout.confirm');
  }
}

/**
 * Implements hook_preprocess_superfish_menu_items().
 */
function montreal2027_preprocess_superfish_menu_items(array &$variables): void {
  foreach ($variables['menu_items'] as &$item) {
    foreach (['link', 'link_menuparent'] as $key) {
      $url = $item[$key]['#url'];
      if ($url instanceof Url && $url->isRouted() && $url->getRouteName() === 'user.logout') {
        $options = $url->getOptions();
        unset($options['query']['token'], $item[$key]['#options']['query']['token']);
        $item[$key]['#url'] = Url::fromRoute('user.logout.confirm', [], $options);
      }
    }
  }
}

/**
 *
 */
function montreal2027_preprocess_block__system_branding_block(&$variables) {
  // Wrap each word in the site slogan with a <span> so it can be styled separately.
  if (!empty($variables['site_slogan'])) {
    // This is user provided input, remove any existing markup and work with the plain text.
    $slogan_text = strip_tags($variables['site_slogan']['#markup']);

    // Explode by whitespace.
    $parts = explode(' ', $slogan_text);

    $wrapped = '';
    foreach ($parts as $part) {
      if (strlen($wrapped) > 0) {
        // Add a space before all but the first word.
        $wrapped .= ' ';
      }

      // Escape the word and wrap it because it's user provided input.
      $wrapped .= '<span class="slogan-word">' . Html::escape($part) . '</span>';
    }

    // Set as render array to ensure it's output as safe markup.
    $variables['site_slogan'] = ['#markup' => $wrapped];
  }
}

/**
 * Get the image alt text and a usable URL from a variety of field item entities.
 *
 * @param mixed $item
 *   A field item, media field item, or render array fragment.
 * @param string $image_style
 *   The machine name of the image style to use for the URL.
 *
 * @returns array An associative array with keys 'alt' and 'url'.
 */
function get_image_info(mixed $item, string $image_style = 'convert_only') {
  $result = [
    'alt' => '',
    'url' => '',
  ];

  // Handle render-array wrapping where the raw field item is stored under '#item'.
  if (is_array($item) && isset($item['#item'])) {
    $item = $item['#item'];
  }

  // If item is a render array that is itself a file render element, try '#file'.
  if (is_array($item) && isset($item['#file']) && is_object($item['#file'])) {
    $file = $item['#file'];
    // Try to get alt from '#options' if provided.
    $alt = '';
    if (isset($item['#options']['alt'])) {
      $alt = (string) $item['#options']['alt'];
    }
    $result['alt'] = $alt;

    // Build URL from file entity if possible.
    if (method_exists($file, 'getFileUri')) {
      $uri = $file->getFileUri();
      if ($uri) {
        $style = ImageStyle::load($image_style);
        if ($style) {
          $result['url'] = $style->buildUrl($uri);
        }
        else {
          $result['url'] = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
        }
      }
    }

    return $result;
  }

  // If $item is an object (FieldItem, File, Media, etc.) inspect it.
  if (is_object($item)) {
    $alt = '';
    $file = NULL;

    // If the item directly has an alt property (common for image field items).
    if (isset($item->alt)) {
      $alt = (string) $item->alt;
    }
    else {
      // Try method-based access; some FieldItem implementations expose get('alt').
      if (method_exists($item, 'get')) {
        try {
          $altVal = $item->get('alt')->getValue();
          if (is_array($altVal)) {
            $alt = reset($altVal) ?: '';
          }
          elseif (is_string($altVal)) {
            $alt = $altVal;
          }
        }
        catch (\Throwable $e) {
          // Ignore.
        }
      }
    }

    // If the item references an entity (could be a file or a media entity).
    if (isset($item->entity) && is_object($item->entity)) {
      $entity = $item->entity;
      try {
        $etype = method_exists($entity, 'getEntityTypeId') ? $entity->getEntityTypeId() : '';
      }
      catch (\Throwable $e) {
        $etype = '';
      }

      // If it's a media entity, find the media's image field item and extract file/alt.
      if ($etype === 'media') {
        $media = $entity;
        $possible_image_fields = [
          'field_media_image',
          'field_media_photo',
          'field_image',
          'image',
          'field_media_picture',
        ];
        $image_item = NULL;
        foreach ($possible_image_fields as $field_name) {
          if ($media->hasField($field_name) && !$media->get($field_name)->isEmpty()) {
            $image_item = $media->get($field_name)->first();
            break;
          }
        }
        if ($image_item) {
          // Extract alt from the media's image field item if available.
          if (isset($image_item->alt)) {
            $alt = (string) $image_item->alt;
          }
          else {
            try {
              $altVal = $image_item->get('alt')->getValue();
              if (is_array($altVal)) {
                $alt = reset($altVal) ?: '';
              }
              elseif (is_string($altVal)) {
                $alt = $altVal;
              }
            }
            catch (\Throwable $e) {
              // Ignore.
            }
          }

          // File entity referenced by the media image field.
          if (isset($image_item->entity) && is_object($image_item->entity)) {
            $file = $image_item->entity;
          }
        }

        // Fallback: if no image_item resolved, try the media's field_media_image directly.
        if (!$file && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
          $maybe = $media->get('field_media_image')->first();
          if ($maybe && isset($maybe->entity) && is_object($maybe->entity)) {
            $file = $maybe->entity;
          }
        }
      }
      else {
        // If the referenced entity is a file entity, use it directly.
        if ($etype === 'file' || is_subclass_of(get_class($entity), 'Drupal\\file\\Entity\\File') || method_exists($entity, 'getFileUri')) {
          $file = $entity;
        }
      }
    }

    // Build the image URL from the resolved file entity when possible.
    if ($file) {
      try {
        $uri = method_exists($file, 'getFileUri') ? $file->getFileUri() : '';
        if ($uri) {
          $style = ImageStyle::load($image_style);
          if ($style) {
            $result['url'] = $style->buildUrl($uri);
          }
          else {
            $result['url'] = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
          }
        }
      }
      catch (\Throwable $e) {
        // Ignore.
      }
    }

    $result['alt'] = $alt;
    return $result;
  }

  // Nothing resolved.
  return $result;
}

/**
 * Preprocess for the node guest teaser template.
 *
 * This uses the generic resolver above to expose guest_image_alt and
 * guest_image_url to the twig template.
 */
function montreal2027_preprocess_node__guest__teaser(array &$variables) {
  // Default values.
  $variables['guest_image_alt'] = '';
  $variables['guest_image_url'] = '';

  if (isset($variables['node']) && $variables['node']->hasField('field_guest_photo') && !$variables['node']->get('field_guest_photo')->isEmpty()) {
    $item = $variables['node']->get('field_guest_photo')->first();
    $info = get_image_info($item, 'guest_photos');

    // Fallback alt to node label if empty.
    $variables['guest_image_alt'] = $info['alt'] !== '' ? $info['alt'] : $variables['node']->label();
    $variables['guest_image_url'] = $info['url'] ?: '';

    $language = \Drupal::languageManager()->getCurrentLanguage();
    $variables['current_langcode'] = $language->getId();
  }

  // Text is configured at /admin/config/montreal2027, translatable via Configuration Translation.
  $template = \Drupal::config('montreal2027_tools.guest_settings')->get('guest_read_more_text');
  if (!$template) {
    $template = t("Read @name's Full Bio");
  }
  $variables['guest_read_more_text'] = strtr($template, ['@name' => $variables['node']->label()]);
}

/**
 *
 */
function montreal2027_preprocess_block__montreal2027_content(&$variables) {
  // Get the current node object if available.
  $node = \Drupal::routeMatch()->getParameter('node');

  // Check if a node was found and pass it to the template.
  if ($node instanceof NodeInterface) {
    $variables['current_node'] = montreal2027_entity_in_content_language($node);
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Provides the routed node and carousel slides for Twig.
 */
function montreal2027_preprocess_page(array &$variables): void {
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if (!$route_node instanceof NodeInterface) {
    return;
  }

  $node = montreal2027_entity_in_content_language($route_node);
  $variables['current_node'] = $node;

  if (!in_array($node->bundle(), ['carousel_slide', 'home_page'], TRUE)) {
    return;
  }

  $variables['carousel_slides'] = [];
  CacheableMetadata::createFromRenderArray($variables)
    ->addCacheableDependency($node)
    ->addCacheTags(['taxonomy_term_list', 'node_list:carousel_slide', 'config:system.date'])
    ->addCacheContexts(montreal2027_carousel_cache_contexts())
    ->applyTo($variables);

  $carousel_term = NULL;
  if ($node->bundle() === 'carousel_slide' && $node->hasField('field_carousel_type') && !$node->get('field_carousel_type')->isEmpty()) {
    $carousel_term = $node->get('field_carousel_type')->entity;
  }
  elseif ($node->bundle() === 'home_page') {
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
      'vid' => 'carousel_type',
      'name' => 'Homepage',
    ]);
    $carousel_term = reset($terms) ?: NULL;
  }

  if ($carousel_term) {
    $variables['carousel_slides'] = montreal2027_carousel_slides($carousel_term, $variables);
  }
}

/**
 * Loads currently active, viewable slides for a carousel term.
 *
 * @param \Drupal\taxonomy\TermInterface $term
 *   Carousel category term.
 * @param array<mixed, mixed> $variables
 *   Page template variables; cache metadata is added in place.
 *
 * @return array<int, array{
 *   title: string|null,
 *   bground_image_id: int|string|null,
 *   bground_image_alt: string|null,
 *   body: array<string, mixed>|null
 *   }>
 *   Slide values for the page template.
 */
function montreal2027_carousel_slides(TermInterface $term, array &$variables): array {
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $cache->addCacheTags(['node_list:carousel_slide', 'taxonomy_term_list', 'config:system.date']);
  $cache->addCacheContexts(montreal2027_carousel_cache_contexts());
  $term = montreal2027_entity_in_content_language($term);
  $term_access = $term->access('view', NULL, TRUE);
  $cache->addCacheableDependency($term);
  $cache->addCacheableDependency($term_access);

  if (!montreal2027_carousel_access_is_allowed($term_access)) {
    $cache->applyTo($variables);
    return [];
  }

  $now = \Drupal::time()->getCurrentTime();
  $context_metadata = montreal2027_carousel_context_cacheability();
  $cache->addCacheableDependency($context_metadata);
  $context_max_age = $context_metadata->getCacheMaxAge();
  $cache_ttl = $context_max_age === \Drupal\Core\Cache\Cache::PERMANENT ? 86400 : min(86400, $context_max_age);
  $id_cache = \Drupal::cache('default');
  $id_cache_key = montreal2027_carousel_slide_ids_cache_key($term->id());
  $cached_ids = $cache_ttl > 0 ? $id_cache->get($id_cache_key) : FALSE;
  if ($cached_ids && is_array($cached_ids->data)) {
    $ids = $cached_ids->data;
    $ids_expiration = $cached_ids->expire;
  }
  else {
    $site_timezone = montreal2027_carousel_site_timezone();
    $today = montreal2027_carousel_today($now, $site_timezone);
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $query = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'carousel_slide')
      ->condition('status', 1)
      ->condition('field_carousel_type.target_id', $term->id());
    $starts = $query->orConditionGroup()
      ->condition('field_start_date.value', NULL, 'IS NULL')
      ->condition('field_start_date.value', $today, '<=');
    $ends = $query->orConditionGroup()
      ->condition('field_end_date.value', NULL, 'IS NULL')
      ->condition('field_end_date.value', $today, '>');
    $ids = array_values($query
      ->condition($starts)
      ->condition($ends)
      ->sort('created', 'ASC')
      ->sort('nid', 'ASC')
      ->execute());
    $ids_expiration = $now + $cache_ttl;
    if ($cache_ttl > 0) {
      $id_cache->set(
        $id_cache_key,
        $ids,
        $ids_expiration,
        array_unique(array_merge(
          ['node_list:carousel_slide', 'config:system.date'],
          $term->getCacheTags(),
          $context_metadata->getCacheTags(),
        )),
      );
    }
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  $slides = [];
  foreach ($storage->loadMultiple($ids) as $slide) {
    $slide = montreal2027_entity_in_content_language($slide);
    $access = $slide->access('view', NULL, TRUE);
    $cache->addCacheableDependency($slide);
    $cache->addCacheableDependency($access);
    if (!montreal2027_carousel_access_is_allowed($access)) {
      continue;
    }

    $media = $slide->hasField('field_hero_image') && !$slide->get('field_hero_image')->isEmpty()
            ? $slide->get('field_hero_image')->entity
            : NULL;
    $media_access = NULL;
    if ($media) {
      $cache->addCacheableDependency($media);
      $media_access = $media->access('view', NULL, TRUE);
      $cache->addCacheableDependency($media_access);
    }
    $media_image = $media && $media->hasField('field_media_image')
            ? $media->get('field_media_image')
            : NULL;
    $image_visible = $media && $media_access && montreal2027_carousel_access_is_allowed($media_access);
    $image_id = $image_visible && $media_image && !$media_image->isEmpty()
            ? $media_image->target_id
            : NULL;
    $image_alt = $image_id ? $media_image->alt : NULL;
    if ($image_id && $media_image->entity) {
      $cache->addCacheableDependency($media_image->entity);
    }

    $title = $slide->hasField('field_slide_title') && !$slide->get('field_slide_title')->isEmpty()
            ? $slide->get('field_slide_title')->value
            : NULL;
    $body = $slide->hasField('body') && !$slide->get('body')->isEmpty()
            ? $slide->get('body')->view(['label' => 'hidden'])
            : NULL;
    $slides[] = [
      'title' => $title,
      'bground_image_id' => $image_id,
      'bground_image_alt' => $image_alt,
      'body' => $body,
    ];
  }

  // Keep render cache and PageCache within the ID list's original expiry.
  $headers = $variables['#attached']['http_header'] ?? [];
  $cache_expiration = montreal2027_carousel_earliest_expiration($ids_expiration, $headers);
  $cache->mergeCacheMaxAge(max(0, $cache_expiration - $now));
  if ($cache_expiration <= $now) {
    // An expired Expires value can otherwise be treated as permanent.
    \Drupal::service('page_cache_kill_switch')->trigger();
  }
  else {
    $variables['#attached']['http_header'][] = [
      'Expires',
      gmdate('D, d M Y H:i:s \G\M\T', $cache_expiration),
      TRUE,
    ];
  }
  $cache->applyTo($variables);

  return $slides;
}

/**
 * Returns the contexts affecting the carousel query.
 */
function montreal2027_carousel_cache_contexts(): array {
  $contexts = ['languages:language_content', 'user.node_grants:view', 'user.permissions'];
  if (\Drupal::moduleHandler()->moduleExists('workspaces')) {
    $contexts[] = 'workspace';
  }
  return $contexts;
}

/**
 * Collects metadata from every context, not only optimized-away contexts.
 */
function montreal2027_carousel_context_cacheability(): CacheableMetadata {
  $tokens = montreal2027_carousel_cache_contexts();
  $metadata = \Drupal::service('cache_contexts_manager')->convertTokensToKeys($tokens);
  foreach (\Drupal\Core\Cache\Context\CacheContextsManager::parseTokens($tokens) as [$id, $parameter]) {
    $metadata = $metadata->merge(\Drupal::service('cache_context.' . $id)->getCacheableMetadata($parameter));
  }
  return $metadata;
}

/**
 * Builds an access-, language-, and workspace-specific key for slide IDs.
 */
function montreal2027_carousel_slide_ids_cache_key(string|int $term_id): string {
  $keys = \Drupal::service('cache_contexts_manager')
    ->convertTokensToKeys(montreal2027_carousel_cache_contexts())
    ->getKeys();
  $metadata = montreal2027_carousel_context_cacheability();
  $tags = $metadata->getCacheTags();
  sort($tags);

  return 'montreal2027:carousel_slide_ids:v2:' . $term_id . ':' . hash('sha256', serialize([$keys, $tags, $metadata->getCacheMaxAge()]));
}

/**
 * Returns the site-configured timezone, independent of the current user.
 */
function montreal2027_carousel_site_timezone(): DateTimeZone {
  $timezone = \Drupal::config('system.date')->get('timezone.default');
  if (!is_string($timezone) || $timezone === '') {
    throw new UnexpectedValueException('The site default timezone (system.date:timezone.default) must be configured.');
  }

  return new DateTimeZone($timezone);
}

/**
 * Formats a timestamp as a date in the site-configured timezone.
 */
function montreal2027_carousel_today(int $timestamp, DateTimeZone $timezone): string {
  return (new DateTimeImmutable('@' . $timestamp))
    ->setTimezone($timezone)
    ->format('Y-m-d');
}

/**
 * Prevents carousel expiry from extending an earlier attached Expires value.
 *
 * @param array<array-key, mixed> $headers
 *   Attached HTTP headers.
 */
function montreal2027_carousel_earliest_expiration(int $carousel_expiration, array $headers): int {
  foreach ($headers as $header) {
    if (!is_array($header) || !isset($header[0], $header[1]) || strcasecmp((string) $header[0], 'Expires') !== 0 || !is_string($header[1])) {
      continue;
    }
    try {
      $existing_expiration = new DateTimeImmutable($header[1]);
    }
    catch (\Exception) {
      continue;
    }
    $carousel_expiration = min($carousel_expiration, $existing_expiration->getTimestamp());
  }

  return $carousel_expiration;
}

/**
 * Evaluates a cacheable access result.
 */
function montreal2027_carousel_access_is_allowed(AccessResultInterface $access): bool {
  return $access->isAllowed();
}

/**
 * Returns an entity translated to current content language when available.
 */
function montreal2027_entity_in_content_language($entity) {
  if (!is_object($entity) || !method_exists($entity, 'hasTranslation')) {
    return $entity;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  if ($langcode && $entity->hasTranslation($langcode)) {
    try {
      return $entity->getTranslation($langcode);
    }
    catch (\Throwable $e) {
      return $entity;
    }
  }

  return $entity;
}

/**
 * Preprocess for paragraph--guest-block.twig and paragraph--guests.twig templates.
 *
 * Resolve the referenced taxonomy term entity from either paragraph.field_block
 * (guest_block) or paragraph.field_guest_type (guests) and pick the appropriate
 * translation using a robust server-side language detection strategy.
 * Expose 'guest_block_entity_translated' and simple conveniences to Twig so
 * templates don't need to reimplement language detection logic.
 */
function montreal2027_preprocess_paragraph__guest_block(array &$variables) {
  montreal2027_preprocess_guest_taxonomy_paragraph($variables);
}

/**
 * Preprocess for paragraph--guests.twig template.
 *
 * Uses the same logic as guest_block to resolve taxonomy term translations.
 */
function montreal2027_preprocess_paragraph__guests(array &$variables) {
  montreal2027_preprocess_guest_taxonomy_paragraph($variables);
}

/**
 * Shared preprocessing logic for guest taxonomy paragraphs.
 *
 * Handles both field_block (guest_block) and field_guest_type (guests).
 */
function montreal2027_preprocess_guest_taxonomy_paragraph(array &$variables) {
  if (empty($variables['paragraph'])) {
    return;
  }
  $paragraph = $variables['paragraph'];

  // Default exposures for Twig.
  $variables['guest_block_entity_translated'] = NULL;
  $variables['guest_block_langcode'] = NULL;
  $variables['guest_block_title'] = '';
  $variables['guest_block_title_plural'] = '';
  $variables['guest_block_description'] = '';

  // Determine which field to use based on paragraph type.
  $referenced = NULL;
  if ($paragraph->hasField('field_block') && !$paragraph->get('field_block')->isEmpty()) {
    $referenced = $paragraph->get('field_block')->entity;
  }
  elseif ($paragraph->hasField('field_guest_type') && !$paragraph->get('field_guest_type')->isEmpty()) {
    $referenced = $paragraph->get('field_guest_type')->entity;
  }

  if (!$referenced) {
    return;
  }

  // Robust language detection (server-side): prefer entity langcode, then
  // current language from language manager, then request attributes.
  $langcode = NULL;

  // 1) Prefer the entity's own langcode (this is safe and explicit).
  try {
    $entity_lang = method_exists($referenced, 'getLangcode') ? $referenced->getLangcode() : NULL;
    if ($entity_lang) {
      $langcode = $entity_lang;
    }
  }
  catch (\Throwable $e) {
    // Ignore.
  }

  // 2) Language manager current language
  if (empty($langcode)) {
    try {
      $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    }
    catch (\Throwable $e) {
      // Ignore.
    }
  }

  // 3) Request attributes (Negotiation may set these)
  if (empty($langcode)) {
    $request = \Drupal::request();
    if ($request) {
      $req_lang = $request->attributes->get('_language');
      if ($req_lang && method_exists($req_lang, 'getId')) {
        $langcode = $req_lang->getId();
      }
    }
  }

  // 4) Locale fallback
  if (empty($langcode)) {
    $request = \Drupal::request();
    if ($request) {
      $locale_attr = $request->attributes->get('_locale');
      if ($locale_attr) {
        $langcode = preg_split('/[_-]/', (string) $locale_attr)[0];
      }
      else {
        $locale = $request->getLocale();
        if ($locale) {
          $langcode = preg_split('/[_-]/', (string) $locale)[0];
        }
      }
    }
  }

  // 5) Fallback: derive language from the first URL path segment (path prefix)
  // This handles cases where language negotiation uses path prefixes (e.g. /fr/...).
  if (empty($langcode)) {
    $request = \Drupal::request();
    if ($request) {
      $path = trim($request->getPathInfo(), '/');

      // If getPathInfo() has had the language prefix removed (some middlewares
      // or language negotiation can do this), try the original request URI
      // and strip base path.
      if ($path === '') {
        $raw = $request->getRequestUri();
        // Remove query string.
        $raw = preg_replace('/\?.*/', '', $raw);
        $base = $request->getBasePath() ?: '';
        if ($base && strpos($raw, $base) === 0) {
          $raw = substr($raw, strlen($base));
        }
        $raw = trim($raw, '/');
        $path = $raw;
      }

      if ($path !== '') {
        $first_segment = preg_split('#/+#', $path)[0];
        // Check against configured languages. Accept exact matches or primary-subtag matches.
        try {
          $languages = \Drupal::languageManager()->getLanguages();
          foreach ($languages as $lid => $lang) {
            // Exact key match first.
            if ($first_segment === $lid) {
              $langcode = $lid;
              break;
            }
            // Accept matching the primary subtag (e.g. 'fr' for 'fr-FR' or 'fr_CA').
            $primary = preg_split('/[_-]/', $lid)[0];
            if ($first_segment === $primary) {
              $langcode = $lid;
              break;
            }
          }
        }
        catch (\Throwable $e) {
          // Ignore.
        }
      }
    }
  }

  // Determine translated entity (if available)
  $translated = $referenced;
  if ($langcode && $referenced->hasTranslation($langcode)) {
    try {
      $translated = $referenced->getTranslation($langcode);
    }
    catch (\Throwable $e) {
      // Ignore and fall back to original.
    }
  }

  $variables['guest_block_entity_translated'] = $translated;
  $variables['guest_block_langcode'] = $langcode;

  // Convenience values for the template.
  try {
    $variables['guest_block_title'] = $translated->label();
  }
  catch (\Throwable $e) {
    $variables['guest_block_title'] = '';
  }

  // Title plural (field_plural)
  if ($translated && $translated->hasField('field_plural') && !$translated->get('field_plural')->isEmpty()) {
    try {
      $variables['guest_block_title_plural'] = (string) $translated->get('field_plural')->first()->value;
    }
    catch (\Throwable $e) {
      $variables['guest_block_title_plural'] = '';
    }
  }

  // Description - guard for the field existence.
  if ($translated && $translated->hasField('description') && !$translated->get('description')->isEmpty()) {
    try {
      $variables['guest_block_description'] = (string) $translated->get('description')->first()->value;
    }
    catch (\Throwable $e) {
      $variables['guest_block_description'] = '';
    }
  }
}
