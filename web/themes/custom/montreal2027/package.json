{
  "name": "montreal2027-theme",
  "version": "1.0.0",
  "description": "Montreal2027 subtheme build scripts",
  "private": true,
  "engines": {
    "node": ">=18.19",
    "npm": ">=10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "sass": "^1.73.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0"
  },
  "scripts": {
    "build:css": "sass --style=compressed src/scss/montreal2027.scss:css/montreal2027.min.css --embed-source-map",
    "watch:css": "sass --watch src/scss/montreal2027.scss:css/montreal2027.min.css --style=compressed --embed-source-map",
    "lint:css": "stylelint",
    "lint:js": "eslint",
    "format:check": "prettier --check"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
