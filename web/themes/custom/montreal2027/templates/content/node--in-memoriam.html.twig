{%
  set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
]
%}
{{ attach_library('classy/node') }}
{% set date_type = false %}

{% if node.field_date_of_death.value matches '/^\\d{4}-\\d{2}-\\d{2}$/' %}
  {% set date_type = 'full' %}
{% elseif node.field_date_of_death.value matches '/^\\d{4}-\\d{2}$/' %}
  {% set date_type = 'month' %}
{% endif %}


<article{{attributes.addClass(classes)}}>
	<div{{content_attributes.addClass('node__content')}}>
<p>{# DO NOT PRETTY PRINT THIS LINE IN THIS PARAGRAPH. IT NEEDS TO BE ONE LINE TO PROPERLY DISPLAY #}
<strong>{% if node.field_first_name is defined and node.field_first_name is not empty %}{{ node.field_first_name.value|trim }}&nbsp;{% endif %}{{ node.label|trim }}</strong>{% if node.field_year_of_birth is defined and node.field_year_of_birth is not empty %}&nbsp;(<strong>b. </strong>{{ node.field_year_of_birth.value|trim }}){% endif %},&nbsp;{% if node.field_category is defined and node.field_category is not empty %}<em>{% for item in node.field_category  %}{{ item.entity.label|trim }}{% if not loop.last %},&nbsp;{% endif %}{% endfor %}</em>{% endif %}{% if node.field_date_of_death is defined and node.field_date_of_death is not empty %}, {{ 'died'|t }} {% if date_type == 'full' %}{{ 'on'|t }} {{ node.field_date_of_death.value|date('U')|format_date('custom', 'M jS, Y') }}{% elseif date_type == 'month' %}{{ 'in'|t }} {{ node.field_date_of_death.value|date('U')|format_date('custom', 'M Y') }}{% else %}{{ node.field_date_of_death.value }}{% endif %}. {% else %}, {% endif %}{% if node.field_reason is defined and node.field_reason is not empty %}{{ node.field_reason.value|striptags }}{% endif %}
{# END OF DO NOT PRETTY PRINT #}
</p>
	</div>
</article>
